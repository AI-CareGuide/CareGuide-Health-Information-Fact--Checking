          "assignments": [
            {
              "id": "03eb0ad2-6ff7-415f-afd2-11996c65a8d3",
              "name": "translated",
              "value": "={{ $json.text }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        -96,
        -128
      ],
      "id": "8c4dcea3-1685-4e3f-a7c9-ebf1982f2bdd",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional Arabic medical translation proofreader.\n\nReview the Arabic medical translation provided below.\n\nYour tasks:\n1. Correct grammar, spelling, punctuation, and awkward phrasing.\n2. Improve clarity and readability while preserving the original meaning.\n3. Preserve all medical and technical terminology, numbers, dosages, units, warnings, and headings accurately.\n4. Do not answer questions contained in the text.\n5. Do not add medical advice, explanations, or information that is not present in the input.\n6. Do not interpret a statement as an incomplete question.\n7. If the text is already correct and clear, return it unchanged.\n8. Return only the final Arabic text, without commentary or follow-up questions.\n\nArabic translation to review:\n{{ $json.text }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
