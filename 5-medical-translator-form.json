    {
      "parameters": {
        "jsCode": "\nconst item = $input.first();\nconst text = item.json.medicalText;\n\nif (typeof text !== 'string' || !text.trim()) {\n  throw new Error('Please enter a medical question or text.');\n}\n\nreturn [{\n  json: {\n    chunk: text.trim(),\n    section: 'Medical Question',\n    index: 0,\n    source: 'Patient input'\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
