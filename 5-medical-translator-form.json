        -224
      ],
      "id": "7f5de0fe-9b27-4537-a6bf-d87902a4017d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional medical translator translating into Modern Standard Arabic.\n\nYour task is to translate the source text into Arabic accurately and faithfully.\n\nStrict requirements:\n1. Translate only the information explicitly present in the source text.\n2. Do not answer questions, explain the content, summarize it, expand it, or provide medical advice.\n3. Never add examples, symptoms, warnings, recommendations, or other information that does not appear in the source.\n4. Preserve the original meaning, tone, headings, lists, numbers, dosages, units, and medical terminology.\n5. Use clear, natural, grammatically correct Modern Standard Arabic.\n6. If the source is already Arabic, preserve its meaning and make only minimal language corrections if needed.\n7. If the source is a short sentence, return only its translation as a short sentence.\n8. Return only the translated text, with no introduction, commentary, or follow-up question.\n\nSource text:\n{{ $json.text }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -464,
        -128
      ],
      "id": "f02788e2-f702-4434-b749-d9e28500a553",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
